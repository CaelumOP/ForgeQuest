<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <include domain="database" path="." />
    <include domain="file" path="." />
    <!-- Meal photos would blow the 25 MB auto-backup quota within months and silently stop the whole backup. -->
    <exclude domain="file" path="photos" />
    <!-- sharedpref is not included, so friends_prefs.xml (session token) is never backed up. Do not include sharedpref without excluding it. -->
</full-backup-content>
